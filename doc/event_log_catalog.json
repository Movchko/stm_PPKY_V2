{
  "schema_version": "1.1",
  "updated": "2026-10-20",
  "source_firmware": {
    "catalog_header": "stm_PPKY_V2/Core/Inc/event_log_catalog.h",
    "catalog_table": "stm_PPKY_V2/Core/Src/event_log_catalog.c",
    "record_struct": "stm_PPKY_V2/Core/Inc/event_logger.h",
    "post_api": "stm_PPKY_V2/Core/Src/event_log.cpp"
  },

  "record": {
    "size_bytes": 32,
    "empty_flash_byte": 255,
    "endianness": "little",
    "description": "Фиксированная запись лога во внешней SPI Flash. Поля time и checksum заполняются прошивкой автоматически при EventLog_Post().",
    "fields": [
      {
        "name": "time",
        "offset": 0,
        "size": 6,
        "type": "bcd_datetime",
        "access": "firmware_auto",
        "description": "Дата и время события в BCD (как в RTC STM32)",
        "subfields": [
          { "offset": 0, "name": "year",   "type": "uint8", "format": "bcd", "range": "0..99", "note": "Год 2000+YY" },
          { "offset": 1, "name": "month",  "type": "uint8", "format": "bcd", "range": "1..12" },
          { "offset": 2, "name": "day",    "type": "uint8", "format": "bcd", "range": "1..31" },
          { "offset": 3, "name": "hour",   "type": "uint8", "format": "bcd", "range": "0..23" },
          { "offset": 4, "name": "minute", "type": "uint8", "format": "bcd", "range": "0..59" },
          { "offset": 5, "name": "second", "type": "uint8", "format": "bcd", "range": "0..59" }
        ]
      },
      {
        "name": "master_wagon_num",
        "offset": 6,
        "size": 1,
        "type": "uint8",
        "access": "payload",
        "description": "Номер мастера (h_adr ППКУ) или номер вагона в составе. 0 — если не используется."
      },
      {
        "name": "reserved",
        "offset": 7,
        "size": 1,
        "type": "uint8",
        "access": "firmware_auto",
        "default": 0,
        "description": "Резерв, всегда 0 при записи через EventLog_Post()."
      },
      {
        "name": "event_code",
        "offset": 8,
        "size": 2,
        "type": "uint16",
        "access": "firmware_auto",
        "description": "Код события (см. events[].code). Little-endian."
      },
      {
        "name": "can_header",
        "offset": 10,
        "size": 4,
        "type": "can_ext_id",
        "access": "payload",
        "description": "29-битный extended CAN ID (см. can_ext_id). Little-endian uint32."
      },
      {
        "name": "can_data",
        "offset": 14,
        "size": 8,
        "type": "bytes",
        "access": "payload",
        "description": "Данные CAN-кадра (до 8 байт). Неиспользуемые байты — 0."
      },
      {
        "name": "additional",
        "offset": 22,
        "size": 8,
        "type": "bytes",
        "access": "payload",
        "description": "Параметры, специфичные для типа события. Неиспользуемые байты — 0."
      },
      {
        "name": "checksum",
        "offset": 30,
        "size": 2,
        "type": "uint16",
        "access": "firmware_auto",
        "description": "CRC-16/CCITT-подобная сумма по байтам [0..29]. Little-endian."
      }
    ]
  },

  "checksum": {
    "algorithm": "crc16_ccitt_like",
    "init": "0xFFFF",
    "polynomial": "0x1021",
    "range_offset": 0,
    "range_size": 30,
    "note": "Совпадает с EventLogTier_CalculateChecksum() в event_logger.cpp: для каждого байта crc ^= byte<<8, затем 8 бит сдвига с xor 0x1021 при старшем бите."
  },

  "can_ext_id": {
    "description": "device_lib/include/backend.h, union can_ext_id_t, 29-bit extended ID",
    "endianness": "little",
    "layout_lsb_first": [
      { "name": "zone",   "bits": 7,  "offset": 0,  "description": "Номер зоны (0..127)" },
      { "name": "l_adr",  "bits": 6,  "offset": 7,  "description": "Подадрес виртуального устройства" },
      { "name": "h_adr",  "bits": 8,  "offset": 13, "description": "Адрес на шине (МКУ/ППКУ)" },
      { "name": "d_type", "bits": 7,  "offset": 21, "description": "Тип устройства (см. device_types)" },
      { "name": "dir",    "bits": 1,  "offset": 28, "description": "0 = команда к устройству, 1 = ответ/статус от устройства" }
    ],
    "decode_example": "can_header = zone | (l_adr<<7) | (h_adr<<13) | (d_type<<21) | (dir<<28)"
  },

  "device_types": {
    "10": { "symbol": "DEVICE_PPKY_TYPE",    "name": "ППКУ" },
    "11": { "symbol": "DEVICE_IGNITER_TYPE", "name": "Спичка (вирт.)" },
    "12": { "symbol": "DEVICE_DPT_TYPE",     "name": "ДПТ (вирт.)" },
    "13": { "symbol": "DEVICE_MCU_IGN_TYPE", "name": "МКУ спички (legacy)" },
    "14": { "symbol": "DEVICE_MCU_TC_TYPE",  "name": "МКУ ТС (legacy)" },
    "15": { "symbol": "DEVICE_BUTTON_TYPE",  "name": "Кнопка (вирт.)" },
    "16": { "symbol": "DEVICE_LSWITCH_TYPE", "name": "Концевик (вирт.)" },
    "17": { "symbol": "DEVICE_RELAY_TYPE",   "name": "Реле (вирт.)" },
    "20": { "symbol": "DEVICE_MCU_K1",       "name": "МКУ K1" },
    "21": { "symbol": "DEVICE_MCU_K2",       "name": "МКУ K2" },
    "22": { "symbol": "DEVICE_MCU_K3",       "name": "МКУ K3" },
    "23": { "symbol": "DEVICE_MCU_KR",       "name": "МКУ KR" }
  },

  "log_levels": {
    "critical": {
      "id": 0,
      "symbol": "EVENT_LOG_LEVEL_CRITICAL",
      "flash_tier": "critical",
      "description": "Только важнейшие события"
    },
    "general": {
      "id": 1,
      "symbol": "EVENT_LOG_LEVEL_GENERAL",
      "flash_tier": "general",
      "description": "Прочие события и диагностика"
    }
  },

  "payload_api": {
    "struct": "EventLogPayload_t",
    "fields": [
      { "name": "master_wagon_num", "maps_to": "record.master_wagon_num" },
      { "name": "can_header",       "maps_to": "record.can_header" },
      { "name": "can_data",         "maps_to": "record.can_data", "size": 8 },
      { "name": "additional",       "maps_to": "record.additional", "size": 8 }
    ],
    "post_function": "EventLog_Post(uint16_t code, const EventLogPayload_t *payload)"
  },

  "events": [
    {
      "code": 1,
      "symbol": "EVENT_LOG_MASTER_START",
      "name": "Запуск мастера",
      "level": "critical",
      "debug_only": false,
      "status": "implemented",
      "description": "Старт ППКУ. Пишет EventLog_LogMasterBoot вместе с кодом 2, если есть метка прошлого включения.",
      "uses": {
        "can_header": "unused",
        "can_data": "unused",
        "additional": "required"
      },
      "payload": {
        "master_wagon_num": {
          "required": true,
          "description": "PPKYConfig.UId.devId.h_adr"
        },
        "can_header": {
          "required": false,
          "default": 0,
          "description": "Писатель оставляет 0"
        },
        "additional": [
          {
            "offset": 0,
            "name": "from_backup",
            "type": "uint8",
            "enum": { "0": "current_rtc" },
            "description": "Всегда 0. Время записи — текущее RTC."
          }
        ]
      },
      "parse_hints": [
        "can_data нули. Байты additional[1..7] нули."
      ]
    },
    {
      "code": 2,
      "symbol": "EVENT_LOG_MASTER_STOP",
      "name": "Выключение мастера",
      "level": "critical",
      "debug_only": false,
      "status": "implemented",
      "description": "Метка прошлого включения, пишется при следующем старте. Если RTC_BKP_DR1 пуст или месяц/день/час/минута не BCD, запись не создаётся.",
      "uses": {
        "can_header": "unused",
        "can_data": "unused",
        "additional": "required"
      },
      "payload": {
        "additional": [
          {
            "offset": 0,
            "name": "from_backup",
            "type": "uint8",
            "enum": { "1": "rtc_backup" },
            "description": "Всегда 1. Время — месяц/день/час/минута из RTC_BKP_DR1, секунды 0. Год — текущий RTC; если метка позже текущего месяца-дня-часа-минуты, год на 1 меньше (00 переходит в 99)."
          }
        ]
      }
    },
    {
      "code": 3,
      "symbol": "EVENT_LOG_SYSTEM_START_OK",
      "name": "Система запустилась успешно",
      "level": "critical",
      "debug_only": false,
      "status": "catalog_only",
      "description": "Код есть в каталоге. EventLog_Post с этим кодом в прошивке не вызывается. Поля ниже в записях не встречаются.",
      "uses": {
        "can_header": "unused",
        "can_data": "unused",
        "additional": "recommended"
      },
      "payload": {
        "additional": [
          {
            "offset": 0,
            "name": "init_status",
            "type": "uint8",
            "required": false,
            "description": "Битовая маска успешной инициализации подсистем",
            "bits": {
              "0": "spi_flash_ok",
              "1": "config_ok",
              "2": "can_ok",
              "3": "display_ok",
              "4": "event_log_ok"
            }
          },
          {
            "offset": 1,
            "name": "active_mcu_count",
            "type": "uint8",
            "required": false,
            "description": "Число обнаруженных МКУ. Поле в каталоге описано заранее: писателя кода 3 нет, байт не заполняется."
          }
        ]
      }
    },
    {
      "code": 4,
      "symbol": "EVENT_LOG_DEVICE_MISSING",
      "name": "Отсутствует устройство",
      "level": "general",
      "debug_only": false,
      "status": "implemented",
      "description": "Ожидаемое по конфигу устройство (МКУ или вирт. канал) не online. additional[0]=phase (0=появилась, 1=устранена), [1]=slot CfgDevices, [2]=l_adr канала (0=МКУ).",
      "uses": {
        "can_header": "recommended",
        "can_data": "optional",
        "additional": "recommended"
      },
      "payload": {
        "can_header": {
          "required": false,
          "description": "ID первого отсутствующего устройства (МКУ или вирт. канал). Может быть 0, если список только в additional."
        },
        "can_data": {
          "required": false,
          "description": "Писатель оставляет нули"
        },
        "additional": [
          {
            "offset": 0,
            "name": "phase",
            "type": "uint8",
            "enum": { "0": "appeared", "1": "cleared" }
          },
          {
            "offset": 1,
            "name": "cfg_slot",
            "type": "uint8",
            "description": "Индекс слота CfgDevices[32]"
          },
          {
            "offset": 2,
            "name": "l_adr",
            "type": "uint8",
            "description": "l_adr вирт. канала; 0 если отсутствует МКУ целиком"
          }
        ]
      }
    },
    {
      "code": 5,
      "symbol": "EVENT_LOG_DEVICE_FOUND",
      "name": "Найдено новое устройство",
      "level": "general",
      "debug_only": false,
      "status": "implemented",
      "description": "На шине online устройство/канал, не совпадающее с PPKYConfig. additional[0]=phase. can_header=фактический ID.",
      "uses": {
        "can_header": "recommended",
        "can_data": "optional",
        "additional": "recommended"
      },
      "payload": {
        "can_header": {
          "required": true,
          "description": "CAN ID обнаруженного устройства (dir=1, d_type/h_adr/zone/l_adr)"
        },
        "additional": [
          {
            "offset": 0,
            "name": "phase",
            "type": "uint8",
            "enum": { "0": "appeared", "1": "cleared" }
          }
        ]
      }
    },
    {
      "code": 6,
      "symbol": "EVENT_LOG_CONFIG_MISMATCH",
      "name": "Конфигурация не совпала",
      "level": "general",
      "debug_only": false,
      "status": "implemented",
      "description": "CRC MKUCfg на online МКУ не совпал с PPKYConfig.CfgDevices[slot]. Периодическая проверка раз в 5 с (round-robin). additional[0]=phase, [1]=slot, [2]=0 (crc).",
      "uses": {
        "can_header": "recommended",
        "can_data": "optional",
        "additional": "recommended"
      },
      "payload": {
        "can_header": {
          "required": true,
          "description": "ID МКУ с расхождением"
        },
        "can_data": {
          "required": false,
          "description": "Писатель оставляет нули"
        },
        "additional": [
          {
            "offset": 0,
            "name": "phase",
            "type": "uint8",
            "enum": { "0": "appeared", "1": "cleared" }
          },
          {
            "offset": 1,
            "name": "cfg_slot",
            "type": "uint8",
            "description": "Индекс слота CfgDevices[32]"
          },
          {
            "offset": 2,
            "name": "mismatch_type",
            "type": "uint8",
            "enum": { "0": "crc" }
          }
        ]
      }
    },
    {
      "code": 7,
      "symbol": "EVENT_LOG_TELEMETRY",
      "name": "Данные телеметрии",
      "level": "general",
      "debug_only": true,
      "status": "not_posted",
      "description": "EventLog_LogCanTelemetry кладёт can_header (маска 0x1FFFFFFF), 8 байт can_data и additional[0]=0. Функция ниоткуда не вызывается. debug_only=1, а EventLog_SetDebug тоже ниоткуда не вызывается, поэтому при обычной работе запись не создаётся.",
      "uses": {
        "can_header": "required",
        "can_data": "required",
        "additional": "optional"
      },
      "payload": {
        "can_header": {
          "required": true,
          "description": "ID источника (вирт. ДПТ, спичка, МКУ и т.д.)"
        },
        "can_data": {
          "required": true,
          "description": "8 байт CAN, которые передали бы в EventLog_LogCanTelemetry. Вызовов нет."
        },
        "additional": [
          {
            "offset": 0,
            "name": "telemetry_kind",
            "type": "uint8",
            "enum": { "0": "raw_frame" },
            "description": "Писатель всегда пишет 0. Другие значения kind не используются."
          }
        ]
      }
    },
    {
      "code": 8,
      "symbol": "EVENT_LOG_DEVICE_FAULT",
      "name": "Ошибка устройства",
      "level": "critical",
      "debug_only": false,
      "status": "implemented",
      "description": "Фронт неисправности из warning: обрыв/КЗ/Fault линии vdev, CAN МКУ/ППКУ, позиция МКУ, выход питания (ВЫХОД1/2). Входы питания ППКУ — коды 28..30. additional[0]=fault_class, [1]=channel или h_adr (для position), [2]=fault_phase (0=появилась, 1=устранена).",
      "uses": {
        "can_header": "required",
        "can_data": "required",
        "additional": "optional"
      },
      "payload": {
        "can_header": {
          "required": true,
          "description": "ID устройства с ошибкой (для position — ID ППКУ)"
        },
        "can_data": {
          "required": true,
          "description": "Для vdev/CAN — статусное сообщение; для position — can_data[0]=h_adr МКУ; для power output — [0]=0, [1]=channel"
        },
        "additional": [
          {
            "offset": 0,
            "name": "fault_class",
            "type": "uint8",
            "enum": {
              "0": "line_break",
              "1": "line_short",
              "2": "protocol_fault",
              "3": "can_fault",
              "4": "power_fault",
              "5": "other",
              "6": "position"
            },
            "note": "fault_class=4 (power_fault) — только выходы ВЫХОД1/2; входы питания — EVENT_LOG_POWER_INPUT_*"
          },
          {
            "offset": 1,
            "name": "channel",
            "type": "uint8",
            "description": "Номер канала/линии (l_adr или индекс CAN); для position — h_adr МКУ; 0 если не применимо"
          },
          {
            "offset": 2,
            "name": "fault_phase",
            "type": "uint8",
            "enum": {
              "0": "appeared",
              "1": "cleared"
            },
            "description": "0 — неисправность появилась, 1 — устранена устройством/системой"
          }
        ]
      }
    },
    {
      "code": 9,
      "symbol": "EVENT_LOG_FIRE_DETECTED",
      "name": "Пожар в системе",
      "level": "critical",
      "debug_only": false,
      "status": "implemented",
      "description": "Fire_LogFireDetected. can_header — ID сообщения (маска 0x1FFFFFFF). can_data — 8 байт этого сообщения, если указатель не пустой.",
      "uses": {
        "can_header": "required",
        "can_data": "optional",
        "additional": "required"
      },
      "payload": {
        "can_header": {
          "required": true,
          "description": "ID сообщения-источника, биты 29..31 обнулены"
        },
        "can_data": {
          "required": false,
          "description": "8 байт CAN-сообщения. Если указатель данных был пуст — нули."
        },
        "additional": [
          {
            "offset": 0,
            "name": "zone",
            "type": "uint8",
            "required": true,
            "description": "Зона, биты 0..6"
          },
          {
            "offset": 1,
            "name": "detect_source",
            "type": "uint8",
            "enum": {
              "0": "dpt",
              "2": "button",
              "3": "external"
            },
            "description": "Fire_LogDetectSource: d_type 12 или can_data[1]=12 → 0, d_type 15 → 2, иначе 3. Константы 1 и 4 в файле есть, этот вызов их не возвращает."
          }
        ]
      }
    },
    {
