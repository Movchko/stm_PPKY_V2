          }
        ]
      }
    },
    {
      "code": 12,
      "symbol": "EVENT_LOG_EXTINGUISH_COMPLETE",
      "name": "Процедура тушения завершена",
      "level": "critical",
      "debug_only": false,
      "status": "implemented",
      "description": "Fire_LogExtinguishComplete, один раз на цикл. additional[0] всегда 0 (FIRE_LOG_COMPLETE_FULL). additional[1] и [2] остаются 0. additional[3] писатель явно ставит в 0. Маска пропущенных шагов не записывается.",
      "uses": {
        "can_header": "optional",
        "can_data": "unused",
        "additional": "recommended"
      },
      "payload": {
        "additional": [
          {
            "offset": 0,
            "name": "completion_status",
            "type": "uint8",
            "enum": {
              "0": "full_success",
              "1": "success_with_skipped_steps",
              "2": "partial"
            }
          },
          {
            "offset": 1,
            "name": "skipped_steps_lo",
            "type": "uint8",
            "description": "Писатель не заполняет, остаётся 0"
          },
          {
            "offset": 2,
            "name": "skipped_steps_hi",
            "type": "uint8",
            "description": "Писатель не заполняет, остаётся 0"
          },
          {
            "offset": 3,
